MONGO_URI=
JWT_SECRET=
CLIENT_ID=
CLIENT_SECRET=
# Comma-separated browser origins (CORS + Google OAuth redirect). Include local + production.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://quizzer-app-sooty.vercel.app
# Fallback when OAuth state is missing (defaults to first ALLOWED_ORIGINS entry if unset)
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:3000
# Local Google OAuth callback (must match Google Cloud "Authorized redirect URIs")
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
# On Render: RENDER_EXTERNAL_URL is set for you. Do NOT set GOOGLE_CALLBACK_URL to localhost there.
# Add this exact URI in Google Cloud → Credentials → OAuth client → Authorized redirect URIs:
# https://YOUR-SERVICE.onrender.com/api/auth/google/callback
PER_QUESTION_SECONDS=60
PORT=3000
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# For hosted API + Vercel frontend: cross-site cookies (optional; defaults use NODE_ENV=production)
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none